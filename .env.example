# Backend API URL — SERVER-ONLY. Never use NEXT_PUBLIC_* for the API host,
# or the real backend URL ships to the browser bundle and shows in DevTools.
# Browser code must call same-origin `/api/...` (rewritten by Next.js below).
INTERNAL_API_URL=http://localhost:4000/api
BACKEND_API_URL=http://localhost:4000/api

# Site URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
