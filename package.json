{
  "name": "nepal-job-scraper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "knip": "knip --reporter compact",
    "typeorm": "typeorm-ts-node-commonjs",
    "init-admin": "tsx scripts/init-admin.ts",
    "scrape": "tsx scripts/run-scraper.ts",
    "migration:generate": "node ./node_modules/tsx/dist/cli.mjs ./node_modules/typeorm/cli.js migration:generate -d scripts/data-source.ts",
    "migration:run": "node ./node_modules/tsx/dist/cli.mjs ./node_modules/typeorm/cli.js migration:run -d scripts/data-source.ts",
    "migration:revert": "node ./node_modules/tsx/dist/cli.mjs ./node_modules/typeorm/cli.js migration:revert -d scripts/data-source.ts",
    "migrate": "yarn migration:run",
    "seed-categories": "tsx scripts/seed-categories.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.66",
    "@radix-ui/react-slot": "^1.2.3",
    "@openrouter/ai-sdk-provider": "^2.1.1",
    "@radix-ui/react-select": "^2.2.6",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@types/xml2js": "^0.4.14",
    "ai": "^6.0.64",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.379.0",
    "next": "14.2.35",
    "next-auth": "^4.24.7",
    "pg": "^8.11.5",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "string-similarity": "^4.0.4",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.3",
    "typeorm": "^0.3.20",
    "typescript": "^5.4.5",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/string-similarity": "^4.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "knip": "^6.32.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
