DATABASE_URL=postgresql://user:pass@host:5432/db
OPENROUTER_API_KEY=your-key-here
# NextAuth - required in production
NEXTAUTH_SECRET=your-random-secret-min-32-chars
# Optional: OPENROUTER_MODEL (default: tngtech/deepseek-r1t-chimera:free - supports tools)
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Maximum thin list-page jobs to enrich from detail pages per source and scrape.
SCRAPER_DETAIL_ENRICH_LIMIT=20


GEMINI_API_KEY=your api key
GEMINI_MODEL=gemini-3.5-flash-lite